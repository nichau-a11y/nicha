# Get transaction-pooler PostgreSQL connection from Supabase > Connect.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST.pooler.supabase.com:6543/postgres
# Generate: node scripts/gen-secret.mjs
PARTNER_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Admin username (not secret). This account uses a DIFFERENT password from partners.
ADMIN_USERNAME=admin
